"""
Snakefile_preprocess — Stages 1-3
==================================
Run locally (Mac / workstation). Prepares all inputs needed for ABCfold
(https://github.com/rigdenlab/ABCFold) to run AlphaFold3, Boltz-2, Chai-1,
OpenFold3, Protenix and RosettaFold3 together.

  1. Sequences   — UniProt → per-protein FASTA
  2. Fold input  — fold_input.json per protein x form (sequence + every
                    replica seed) — AlphaFold3-dialect JSON, ABCfold's own
                    native input format
  3. MMseqs2     — "default run" MSA + top-hit templates from the ColabFold
     default run   webserver (no manual curation, no pocket restraint —
                    mirrors NPF_pocket_pipeline's templates.default_run),
                    fetched ONCE per base protein via ABCfold's own
                    `mmseqs2msa` CLI and embedded into fold_input.json so
                    every backend has everything it needs offline.

Every protein is run TWICE: once apoform (no ligand) and, whenever
ligand_for() assigns one, once holoform. Apo/holo are modeled as separate
protein identifiers ("{protein}__apo" / "{protein}__holo") rather than
nested subfolders, so downstream stages (submit_abcfold.sh,
tm_helix_alignment.py) that treat the protein-folder name as an opaque key
need no changes.

Also writes data/fold_inputs/priority_gibberellin.txt: the list of
apo/holo run identifiers for Gibberellin (GA1) importers — the protein
class notebook/tm_conformation_clustering_gibberellin_boltz.ipynb showed
AF3 alone (even with 30 seeds) does not recover every conformation a
second model finds. worflows/processing/submit_abcfold.sh reads this file
to process that group first.

Interface to processing stage:
  data/fold_inputs/{protein}__apo/fold_input.resolved.json   (always, no ligand)
  data/fold_inputs/{protein}__holo/fold_input.resolved.json  (only if a ligand is assigned)
  data/fold_inputs/priority_gibberellin.txt                  (GA1 run identifiers, priority order)
  data/sequences/sequences.done                              (base protein name list)

Usage:
  snakemake -s worflows/preprocessing/Snakefile --cores 4 --use-conda
"""

import sys
from pathlib import Path

sys.path.insert(0, "scripts")
from ligand_assignment import ligand_for, is_gibberellin_importer, GIBBERELLIN_IMPORTERS  # noqa: E402

configfile: "config.yaml"

if Path("config.local.yaml").exists():

    configfile: "config.local.yaml"


# ── Directory shortcuts ────────────────────────────────────────────────────────
DIRS = config["dirs"]
FASTA_DIR = Path(DIRS["fasta"])
FOLD_IN_DIR = Path(DIRS["fold_in"])
LOG_DIR = Path(DIRS["logs"])
AF3_CFG = config["af3"]
MMSEQS_CFG = config["mmseqs2"]
LIGANDS = config["ligands"]

SEQ_SENTINEL = FASTA_DIR / "sequences.done"
PRIORITY_MANIFEST = FOLD_IN_DIR / "priority_gibberellin.txt"


# ── Ligand assignment (apoform → holoform) ─────────────────────────────────────
# ligand_for()/is_gibberellin_importer()/GIBBERELLIN_IMPORTERS now live in
# scripts/ligand_assignment.py (imported above) — factored out so anything
# else that needs the same protein->ligand groupings (e.g.
# rescoring/src/fit_pocket_lda.py) can import it directly instead of a third
# hand-copy of these lists (generate_notebook_protein_cells.py's generated
# notebook-cell template is a second, deliberate string-embedded copy —
# notebooks must stay self-contained, see that script's module docstring).
# See scripts/ligand_assignment.py's own module docstring for the full
# substrate-table rationale.


def base_protein_of(combined_protein):
    """Strip the '__apo' / '__holo' suffix to recover the fasta basename."""
    return combined_protein.rsplit("__", 1)[0]


def fasta_input(wildcards):
    return str(FASTA_DIR / f"{base_protein_of(wildcards.protein)}.fasta")


def ligand_args(wildcards):
    combined = wildcards.protein
    if combined.endswith("__apo"):
        return ""
    if not combined.endswith("__holo"):
        raise ValueError(f"protein wildcard must end in '__apo' or '__holo': {combined}")
    base = base_protein_of(combined)
    ligand_key = ligand_for(base)
    if ligand_key is None:
        raise ValueError(f"No ligand assigned for holoform target {combined}")
    return f"--ligand-smiles '{LIGANDS[ligand_key]['smiles']}' --ligand-name {ligand_key}"


def read_proteins(sentinel_path):
    p = Path(sentinel_path)
    if p.exists():
        return [line.strip() for line in p.read_text().splitlines() if line.strip()]
    return []


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 1: Sequence download (checkpoint — discovers protein list)
# ─────────────────────────────────────────────────────────────────────────────


checkpoint download_sequences:
    output:
        sentinel=str(SEQ_SENTINEL),
    log:
        str(LOG_DIR / "download_sequences.log"),
    conda:
        "../../envs/preprocessing.yaml"
    params:
        fasta_dir=str(FASTA_DIR),
        query=config["uniprot"]["query"],
        size=config["uniprot"]["size"],
    shell:
        """
        python scripts/download_sequences.py \\
        --fasta-dir {params.fasta_dir} \\
        --sentinel {output.sentinel} \\
        --query '{params.query}' \\
        --size {params.size} \\
        >{log} 2>&1
        """


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 2: fold_input.json (one per protein x apo/holo form, all seeds inside)
# ─────────────────────────────────────────────────────────────────────────────


rule prepare_af3_input:
    input:
        fasta=fasta_input,
        seq_done=str(SEQ_SENTINEL),
    output:
        json=str(FOLD_IN_DIR / "{protein}" / "fold_input.json"),
    log:
        str(LOG_DIR / "af3_input" / "{protein}.log"),
    conda:
        "../../envs/preprocessing.yaml"
    params:
        n_replicas=AF3_CFG["n_replicas"],
        seed_strategy=AF3_CFG["seed_strategy"],
        seed_base=AF3_CFG["seed_base"],
        random_master_seed=AF3_CFG["random_master_seed"],
        dialect=AF3_CFG["dialect"],
        json_version=AF3_CFG["json_version"],
        ligand_args=ligand_args,
    shell:
        """
        python scripts/make_af3_input.py \\
        --fasta {input.fasta} \\
        --protein-name {wildcards.protein} \\
        --output {output.json} \\
        --n-replicas {params.n_replicas} \\
        --seed-strategy {params.seed_strategy} \\
        --seed-base {params.seed_base} \\
        --random-master-seed {params.random_master_seed} \\
        --dialect {params.dialect} \\
        --json-version {params.json_version} \\
        {params.ligand_args} \\
        >{log} 2>&1
        """


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 3: MMseqs2 "default run" — MSA + templates from the ColabFold webserver
# ─────────────────────────────────────────────────────────────────────────────
# Run once per BASE protein (on the apoform JSON — apo and holo share the
# same sequence), then copied onto the holoform JSON by inject_mmseqs_msa.py
# so the webserver is never queried twice for one sequence.


rule fetch_mmseqs2_msa:
    input:
        json=str(FOLD_IN_DIR / "{base}__apo" / "fold_input.json"),
    output:
        resolved=str(FOLD_IN_DIR / "{base}__apo" / "fold_input.resolved.json"),
    log:
        str(LOG_DIR / "mmseqs2_msa" / "{base}__apo.log"),
    conda:
        "../../envs/preprocessing.yaml"
    params:
        num_templates=MMSEQS_CFG["num_templates"],
        retries=MMSEQS_CFG["retries"],
        delay=MMSEQS_CFG["delay"],
        pocket_pipeline_dir=MMSEQS_CFG.get("pocket_pipeline_dir", ""),
    shell:
        """
        python scripts/fetch_mmseqs2_msa.py \\
        --input-json {input.json} \\
        --output-json {output.resolved} \\
        --num-templates {params.num_templates} \\
        --retries {params.retries} \\
        --delay {params.delay} \\
        --pocket-pipeline-dir '{params.pocket_pipeline_dir}' \\
        >{log} 2>&1
        """


rule inject_mmseqs_msa_holo:
    input:
        apo_resolved=str(FOLD_IN_DIR / "{base}__apo" / "fold_input.resolved.json"),
        holo_base=str(FOLD_IN_DIR / "{base}__holo" / "fold_input.json"),
    output:
        resolved=str(FOLD_IN_DIR / "{base}__holo" / "fold_input.resolved.json"),
    log:
        str(LOG_DIR / "mmseqs2_msa" / "{base}__holo.log"),
    conda:
        "../../envs/preprocessing.yaml"
    shell:
        """
        python scripts/inject_mmseqs_msa.py \\
        --apo-resolved {input.apo_resolved} \\
        --holo-base {input.holo_base} \\
        --output {output.resolved} \\
        >{log} 2>&1
        """


# ─────────────────────────────────────────────────────────────────────────────
# Priority manifest — Gibberellin (GA1) importers first
# ─────────────────────────────────────────────────────────────────────────────
# notebook/tm_conformation_clustering_gibberellin_boltz.ipynb (AF3_NPF_pipeline)
# showed AF3 alone doesn't recover every conformation a second model finds
# for this group, which is why this pipeline exists — so it's also the
# group worflows/processing/submit_abcfold.sh should burn cluster time on
# first.


def priority_targets(wildcards):
    sentinel = checkpoints.download_sequences.get().output.sentinel
    proteins = read_proteins(sentinel)
    targets = []
    for protein in proteins:
        if not is_gibberellin_importer(protein):
            continue
        targets.append(f"{protein}__apo")
        if ligand_for(protein) is not None:
            targets.append(f"{protein}__holo")
    return targets


rule write_priority_manifest:
    input:
        seq_done=str(SEQ_SENTINEL),
    output:
        manifest=str(PRIORITY_MANIFEST),
    params:
        runs=priority_targets,
    run:
        Path(output.manifest).parent.mkdir(parents=True, exist_ok=True)
        Path(output.manifest).write_text("\n".join(params.runs) + "\n")
        print(f"[priority] {len(params.runs)} Gibberellin-importer run(s) → {output.manifest}")


# ─────────────────────────────────────────────────────────────────────────────
# RULE ALL — preprocess target
# ─────────────────────────────────────────────────────────────────────────────


def all_preprocess_targets(wildcards):
    """Apoform always; holoform only when ligand_for() assigns a ligand.
    Protein list comes from the download_sequences checkpoint sentinel."""
    sentinel = checkpoints.download_sequences.get().output.sentinel
    proteins = read_proteins(sentinel)
    targets = []
    for protein in proteins:
        targets.append(str(FOLD_IN_DIR / f"{protein}__apo" / "fold_input.resolved.json"))
        if ligand_for(protein) is not None:
            targets.append(str(FOLD_IN_DIR / f"{protein}__holo" / "fold_input.resolved.json"))
    return targets


rule all:
    default_target: True
    input:
        all_preprocess_targets,
        str(PRIORITY_MANIFEST),
