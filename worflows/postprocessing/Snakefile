"""
Snakefile_postprocess — Stages 5-7
====================================
Run locally (Mac / workstation) after worflows/processing/submit_abcfold.sh
has completed on the cluster and results/abcfold/ has been rsynced back.

Pipeline order
--------------
  5. deeptmhmm_topology        — TM-helix topology via DeepTMHMM (BioLib cloud)
  6. compress_abcfold_metadata — trim + standardize each run's raw ABCfold
                                  output (HDF5 arrays + Parquet metadata),
                                  deleting the now-redundant raw confidence
                                  sprawl as soon as it's verified. Runs
                                  BEFORE stage 7 so disk usage drops per-
                                  protein as early as possible.

                                  worflows/processing/submit_abcfold.sh's
                                  SLURM array now does this same conversion
                                  on the compute node, right after each
                                  run's `abcfold` call, BEFORE rsync — that's
                                  the primary path (fewer/smaller files to
                                  transfer, avoids IFB's file-count quota).
                                  This rule is what makes that safe to rely
                                  on without babysitting it: it's a plain
                                  Snakemake rule with model_metadata.parquet
                                  + arrays.h5 as outputs, so normal DAG
                                  evaluation already gives the "skip if
                                  already done, run if not" behavior for
                                  free — no detection logic needed. A run
                                  rsynced back pre-compressed (from the
                                  cluster) already has those outputs and
                                  this rule is a no-op for it; a run whose
                                  cluster-side compression failed/timed out,
                                  or that was rsynced back from before that
                                  cluster-side step existed, still has its
                                  raw confidence sprawl on disk and gets
                                  compressed right here instead — same
                                  script, same result, just running locally.
  7. tm_helix_alignment        — Kabsch superposition of every model CIF
                                  ABCfold produced (pooled across all 6
                                  backends x seed) onto the 12 TM-helix Cα
                                  atoms, per protein x form. Depends on
                                  stage 6 having run for that protein
                                  (ordering only — it never reads anything
                                  stage 6 deletes, only CIFs + the small
                                  per-sample summary-confidence files, both
                                  left untouched by compress_abcfold_metadata)
  8. cluster_conformations     — headless, non-interactive port of
                                  scripts/_notebook_setup_functions.py's
                                  plot_pca()/plot_ligand_pca(): GMM macro-
                                  state clustering (k=3, tag "pca_k3") of
                                  the pooled apo+holo TM-Cα ensemble, then
                                  — for holoform (ligand-assigned) proteins
                                  — GMM-auto ligand-pose sub-clustering per
                                  macro-state cluster. See
                                  scripts/cluster_conformations.py's module
                                  docstring for the exact scheme (matches
                                  what's already on disk under
                                  results/tm_reannotated/ and
                                  results/ligand_pose/ from earlier manual
                                  notebook runs).

Prerequisites:
  - worflows/preprocessing/Snakefile completed (data/sequences/sequences.done exists)
  - worflows/processing/submit_abcfold.sh completed — prediction.done exists per run
  - results/abcfold/ transferred back from the cluster

Usage:
  snakemake -s worflows/postprocessing/Snakefile --cores 8 --use-conda
"""

from pathlib import Path

configfile: "config.yaml"
if Path("config.local.yaml").exists():
    configfile: "config.local.yaml"

# ── Directory shortcuts ────────────────────────────────────────────────────────
DIRS = config["dirs"]
FASTA_DIR   = Path(DIRS["fasta"])
INTERPRO_DIR = Path(DIRS["interpro"])
ABCFOLD_OUT_DIR = Path(DIRS["abcfold_out"])
ALIGN_DIR   = Path(DIRS["tm_alignment"])
REANN_DIR   = Path(DIRS["tm_reannotated"])
LOG_DIR     = Path(DIRS["logs"])

DEEPTMHMM_CFG = config["deeptmhmm"]
TM_ALIGN_CFG  = config["tm_alignment"]
METADATA_CFG  = config["metadata_compress"]
METADATA_DIR  = Path(DIRS["metadata"])

SEQ_SENTINEL = FASTA_DIR / "sequences.done"
TOPOLOGY_JSON = INTERPRO_DIR / "tm_topology_summary.json"
TOPO_SENTINEL = INTERPRO_DIR / "deeptmhmm_topology.done"


def read_proteins(sentinel_path):
    p = Path(sentinel_path)
    if p.exists():
        return [line.strip() for line in p.read_text().splitlines() if line.strip()]
    return []


PROTEINS = read_proteins(SEQ_SENTINEL)
if not PROTEINS:
    raise ValueError(
        f"\n Cannot read protein list from {SEQ_SENTINEL}.\n"
        " Run worflows/preprocessing/Snakefile first.\n"
    )

# Each base protein was preprocessed into up to two ABCfold runs (apoform
# always, holoform when worflows/preprocessing/Snakefile's ligand_for()
# assigned a ligand) — results/abcfold/<protein>__apo/ and
# results/abcfold/<protein>__holo/, not results/abcfold/<protein>/. Only
# runs whose ABCfold job has actually completed get an alignment target —
# a fresh checkout has no results/abcfold/ yet, so this list is simply
# empty until submit_abcfold.sh runs.
RUNS = [f"{p}__{form}" for p in PROTEINS for form in ("apo", "holo")]
DONE_PROTEINS = [
    r for r in RUNS
    if (ABCFOLD_OUT_DIR / r / "prediction.done").exists()
]

print(
    f"[postprocess] {len(PROTEINS)} protein(s) known | "
    f"{len(DONE_PROTEINS)} apo/holo run(s) with a completed ABCfold run."
)

# Purely informational — detection itself is just the compress_abcfold_metadata
# rule's own output-existence check (see its comment below); this only tells
# you up front how many runs it'll actually have to do local work for.
_ALREADY_COMPRESSED = [
    r for r in DONE_PROTEINS
    if (METADATA_DIR / r / "model_metadata.parquet").exists()
    and (METADATA_DIR / r / "arrays.h5").exists()
]
print(
    f"[postprocess] {len(_ALREADY_COMPRESSED)}/{len(DONE_PROTEINS)} run(s) already "
    f"compressed (cluster-side, or a prior local run) | "
    f"{len(DONE_PROTEINS) - len(_ALREADY_COMPRESSED)} need local compress_abcfold_metadata."
)

# Base protein names (no __apo/__holo suffix) whose apoform ABCfold run has
# completed -- stage 8's macro-state clustering requires apoform (see
# scripts/cluster_conformations.py's _load_protein: apoform is the Kabsch
# anchor every holoform frame gets refit onto, so it's a hard requirement
# even for proteins with no ligand assigned at all). Whether a given base
# protein ALSO has a completed holoform run (i.e. worflows/preprocessing/
# Snakefile's ligand_for() assigned it a ligand) is decided per-wildcards by
# cluster_conformations_input below, straight off this same DONE_PROTEINS
# list -- no need to re-import ligand_for() here just to answer that.
CLUSTER_BASE_PROTEINS = sorted({
    r.rsplit("__", 1)[0] for r in DONE_PROTEINS if r.endswith("__apo")
})


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 5: TM topology via DeepTMHMM
# ─────────────────────────────────────────────────────────────────────────────


rule run_deeptmhmm_topology:
    input:
        fasta=str(FASTA_DIR / "npf_arabidopsis.fasta"),
        seq_done=str(SEQ_SENTINEL),
    output:
        gff3=str(INTERPRO_DIR / "deeptmhmm_TMRs.gff3"),
        topology=str(TOPOLOGY_JSON),
        sentinel=str(TOPO_SENTINEL),
    log:
        str(LOG_DIR / "deeptmhmm_topology.log"),
    conda:
        "../../envs/tm_analysis.yaml"
    params:
        expected_tm=DEEPTMHMM_CFG["expected_tm"],
    shell:
        """
        python scripts/run_deeptmhmm_topology.py \\
            --fasta       {input.fasta} \\
            --gff3        {output.gff3} \\
            --topology    {output.topology} \\
            --sentinel    {output.sentinel} \\
            --expected-tm {params.expected_tm} \\
        > {log} 2>&1
        """


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 6: trim + standardize raw ABCfold outputs (HDF5 arrays + Parquet
# metadata), deleting the now-redundant raw confidence sprawl as soon as
# it's verified. Runs BEFORE stage 7 (tm_helix_alignment) on purpose — see
# module docstring — so disk usage drops per-protein as early as possible.
# --delete-originals only removes what scripts/compress_abcfold_metadata.py
# itself just converted + spot-checked against source for THIS protein (its
# own verify-then-delete gate, documented in that script's module
# docstring); it never touches CIFs or the small per-sample summary-
# confidence files stage 7 depends on.
#
# BACKWARD-COMPATIBILITY / FALLBACK NOTE: worflows/processing/submit_abcfold.sh
# now runs this exact same conversion on the compute node before rsync (the
# primary path). This rule's job/output/wildcards shape is unchanged by
# that — `output.parquet`/`output.h5` already existing (rsynced in already-
# compressed) is exactly the condition Snakemake's normal DAG evaluation
# uses to consider a rule's target up to date, so a pre-compressed run is
# skipped automatically. Nothing further to add for that: this rule runs
# (and only runs) for a protein that still needs it, whether that's because
# cluster-side compression there failed/timed out, or because
# results/abcfold/<protein>/ was rsynced back from before that cluster-side
# step existed at all.
# ─────────────────────────────────────────────────────────────────────────────


rule compress_abcfold_metadata:
    input:
        abcfold_done=str(ABCFOLD_OUT_DIR / "{protein}" / "prediction.done"),
    output:
        parquet=str(METADATA_DIR / "{protein}" / "model_metadata.parquet"),
        h5=str(METADATA_DIR / "{protein}" / "arrays.h5"),
    log:
        str(LOG_DIR / "compress_abcfold_metadata" / "{protein}.log"),
    conda:
        "../../envs/metadata_compress.yaml"
    params:
        abcfold_output_root=str(ABCFOLD_OUT_DIR),
        out_root=str(METADATA_DIR),
        sample_checks=METADATA_CFG["sample_checks"],
    shell:
        """
        python scripts/compress_abcfold_metadata.py \\
            --protein              {wildcards.protein} \\
            --abcfold-output-root  {params.abcfold_output_root} \\
            --out-root             {params.out_root} \\
            --sample-checks        {params.sample_checks} \\
            --delete-originals \\
            --skip-merge \\
        > {log} 2>&1
        """


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 7: TM-helix Kabsch alignment (per protein x form, all backends pooled)
# ─────────────────────────────────────────────────────────────────────────────


rule tm_helix_alignment:
    input:
        topology=str(TOPOLOGY_JSON),
        topo_done=str(TOPO_SENTINEL),
        abcfold_done=str(ABCFOLD_OUT_DIR / "{protein}" / "prediction.done"),
        # Ordering dependency only (stage 6 runs first so disk usage drops
        # as early as possible) — this rule never reads model_metadata.parquet
        # or arrays.h5, and stage 6 never deletes anything this rule needs.
        metadata_done=str(METADATA_DIR / "{protein}" / "model_metadata.parquet"),
    output:
        aligned_ca=str(ALIGN_DIR / "{protein}" / "aligned_ca.npy"),
        aligned_ca_tm=str(ALIGN_DIR / "{protein}" / "aligned_ca_tm.npy"),
        meta=str(ALIGN_DIR / "{protein}" / "meta.parquet"),
        resids=str(ALIGN_DIR / "{protein}" / "resids.parquet"),
    log:
        str(LOG_DIR / "tm_alignment" / "{protein}.log"),
    conda:
        "../../envs/tm_analysis.yaml"
    params:
        abcfold_output_root=str(ABCFOLD_OUT_DIR),
        out_root=str(ALIGN_DIR),
        n_iter=TM_ALIGN_CFG["n_iter"],
    shell:
        """
        python scripts/tm_helix_alignment.py \\
            --protein              {wildcards.protein} \\
            --abcfold-output-root  {params.abcfold_output_root} \\
            --topology             {input.topology} \\
            --out-root             {params.out_root} \\
            --n-iter               {params.n_iter} \\
        > {log} 2>&1
        """


rule merge_metadata:
    # Separate from compress_abcfold_metadata so N parallel per-protein jobs
    # never race on writing the same all_models.parquet — this runs once,
    # after every per-protein model_metadata.parquet already exists.
    input:
        [str(METADATA_DIR / protein / "model_metadata.parquet") for protein in DONE_PROTEINS],
    output:
        str(METADATA_DIR / "all_models.parquet"),
    log:
        str(LOG_DIR / "merge_metadata.log"),
    conda:
        "../../envs/metadata_compress.yaml"
    params:
        out_root=str(METADATA_DIR),
    shell:
        """
        python -c "
import sys; sys.path.insert(0, 'scripts')
from pathlib import Path
from compress_abcfold_metadata import merge_all
merge_all(Path('{params.out_root}'))
" \\
        > {log} 2>&1
        """


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 8: conformational clustering (macro-state, then per-macro-state
# ligand pose) — headless, non-interactive port of
# scripts/_notebook_setup_functions.py's plot_pca()/plot_ligand_pca() (the
# functions driving the manually-run tm_conformation_clustering_*.ipynb
# notebooks). See scripts/cluster_conformations.py's module docstring for
# the exact fixed clustering scheme (GMM k=3 macro-state, tag "pca_k3", then
# GMM auto ligand-pose sub-clustering per macro-state cluster) — chosen to
# exactly match what's already on disk under results/tm_reannotated/ and
# results/ligand_pose/ from the earlier manual notebook runs, so this rule
# can safely re-derive (not just extend) those directories for any protein.
#
# wildcards.protein here is the BASE protein name (no __apo/__holo suffix),
# unlike stages 6/7 above — cluster_conformations.py pools both runs itself
# (via _load_protein), so it needs both directories, not one run at a time.
# ─────────────────────────────────────────────────────────────────────────────


def cluster_conformations_input(wildcards):
    inputs = {
        "apo_ca": str(ALIGN_DIR / f"{wildcards.protein}__apo" / "aligned_ca_tm.npy"),
        "apo_resids": str(ALIGN_DIR / f"{wildcards.protein}__apo" / "resids.parquet"),
    }
    if f"{wildcards.protein}__holo" in DONE_PROTEINS:
        inputs["holo_ca"] = str(ALIGN_DIR / f"{wildcards.protein}__holo" / "aligned_ca_tm.npy")
    return inputs


rule cluster_conformations:
    input:
        unpack(cluster_conformations_input),
    output:
        sentinel=str(REANN_DIR / "{protein}" / "pca_k3" / "cluster.done"),
    log:
        str(LOG_DIR / "cluster_conformations" / "{protein}.log"),
    conda:
        "../../envs/clustering.yaml"
    params:
        max_per_cluster=20,
    shell:
        """
        python scripts/cluster_conformations.py \\
            --protein          {wildcards.protein} \\
            --max-per-cluster  {params.max_per_cluster} \\
        > {log} 2>&1
        """


# ─────────────────────────────────────────────────────────────────────────────
# RULE ALL — postprocess targets
# ─────────────────────────────────────────────────────────────────────────────

TARGETS = (
    [str(TOPO_SENTINEL)]
    + [str(ALIGN_DIR / protein / "aligned_ca.npy") for protein in DONE_PROTEINS]
    + [str(METADATA_DIR / protein / "model_metadata.parquet") for protein in DONE_PROTEINS]
    + ([str(METADATA_DIR / "all_models.parquet")] if DONE_PROTEINS else [])
    + [str(REANN_DIR / protein / "pca_k3" / "cluster.done") for protein in CLUSTER_BASE_PROTEINS]
)

rule all:
    default_target: True
    input:
        TARGETS,
