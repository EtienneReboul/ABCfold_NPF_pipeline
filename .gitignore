# ── Pipeline runtime outputs ──────────────────────────────────────────────────
data/sequences/
data/fold_inputs/
data/interpro/
results/
logs/

# redocking/ generated output (GA1 sdf/log, manifest.csv, receptor PDBs,
# restraints, cached downloads, acpype CNS topology/params) -- all
# regenerable from redocking/src/*.py against upstream pipeline data, none
# of it is source. Only redocking/src/, README.md, and envs/redocking.yaml
# are tracked.
redocking/data/
redocking/ligand_topology/

# mmgbsa/ generated output (GA1 GAFF2/AM1-BCC params, manifest.csv, acpype
# cache) -- regenerable from mmgbsa/src/*.py; mmgbsa/results/ is covered by
# the global results/ rule above. Only mmgbsa/src/, README.md, RESULTS.md and
# envs/mmgbsa.yaml are tracked.
mmgbsa/data/

